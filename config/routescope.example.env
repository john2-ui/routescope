# HTTP listener: keep this on localhost until authentication is implemented.
ROUTESCOPE_LISTEN_ADDR=127.0.0.1:8080

ROUTESCOPE_DATABASE_PATH=data/routescope.db

# TODO: Add local account credentials through a secure setup command.
# ROUTESCOPE_ADMIN_USERNAME=admin
# ROUTESCOPE_ADMIN_PASSWORD_HASH=

# Enable the first TC eBPF collector only inside a prepared Linux router.
ROUTESCOPE_ENABLE_TC_EBPF=0
ROUTESCOPE_LAN_INTERFACE=br-lan
ROUTESCOPE_WAN_INTERFACE=eth0
ROUTESCOPE_COLLECT_INTERVAL_SECS=5

# Keep synthetic observations disabled outside local development.
ROUTESCOPE_ENABLE_SIMULATOR=0
ROUTESCOPE_SIMULATOR_INTERVAL_SECS=5
