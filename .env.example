# Copy this file to .env for local development.
ROUTESCOPE_LISTEN_ADDR=127.0.0.1:8080
ROUTESCOPE_DATABASE_PATH=data/routescope.db
ROUTESCOPE_DEV_BYPASS_AUTH=1
ROUTESCOPE_ENABLE_SIMULATOR=0
ROUTESCOPE_SIMULATOR_INTERVAL_SECS=5
ROUTESCOPE_ENABLE_TC_EBPF=0
ROUTESCOPE_LAN_INTERFACE=br-lan
ROUTESCOPE_WAN_INTERFACE=eth0
ROUTESCOPE_COLLECT_INTERVAL_SECS=5
ROUTESCOPE_ENABLE_CONNTRACK=0
ROUTESCOPE_CONNTRACK_REFRESH_INTERVAL_SECS=5