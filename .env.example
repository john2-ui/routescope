# Copy this file to .env for local development.
ROUTESCOPE_LISTEN_ADDR=127.0.0.1:8080
ROUTESCOPE_DATABASE_PATH=data/routescope.db
# The bypass is accepted only for loopback listeners and is for local development.
ROUTESCOPE_DEV_BYPASS_AUTH=1
ROUTESCOPE_ADMIN_USERNAME=admin
# Generate with: printf '%s\n' 'change-me' | cargo run --quiet -- hash-password
# Must be single-quoted: make run sources .env via shell, which expands $...
# ROUTESCOPE_ADMIN_PASSWORD_HASH='$argon2id$v=19$m=...$salt$hash'
ROUTESCOPE_SECURE_COOKIES=0
ROUTESCOPE_ENABLE_SIMULATOR=0
ROUTESCOPE_SIMULATOR_INTERVAL_SECS=5
ROUTESCOPE_ENABLE_TC_EBPF=0
ROUTESCOPE_LAN_INTERFACE=br-lan
ROUTESCOPE_WAN_INTERFACE=eth0
ROUTESCOPE_COLLECT_INTERVAL_SECS=5
ROUTESCOPE_ENABLE_CONNTRACK=0
ROUTESCOPE_CONNTRACK_REFRESH_INTERVAL_SECS=5
ROUTESCOPE_ENABLE_DNS_PROXY=0
ROUTESCOPE_DNS_LISTEN_ADDR=127.0.0.1:5353
ROUTESCOPE_DNS_UPSTREAM_ADDR=1.1.1.1:53
ROUTESCOPE_DNS_QUERY_TIMEOUT_MS=2000